{
  "manifest_version": 3,
  "name": "Classic Studio",
  "description": "Bring back the classic Analytics layout and video list in YouTube Studio.",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "classic.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
